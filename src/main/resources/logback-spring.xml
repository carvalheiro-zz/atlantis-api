<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Propriedades dos diretórios e nomes de arquivo -->
    <property name="LOG_PATH" value="${LOG_PATH:-./logs}" />
    <property name="LOG_FILE_NAME" value="atlantis" />

    <!-- 1. Appender para CONSOLE (JSON) -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>true</includeContext>
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampPattern>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <level>level</level>
                <thread>thread</thread>
                <logger>logger</logger>
                <message>message</message>
            </fieldNames>
        </encoder>
    </appender>

    <!-- 2. Appender para ARQUIVO COM ROTAÇÃO (JSON) -->
    <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>
        
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>true</includeContext>
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampPattern>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <level>level</level>
                <thread>thread</thread>
                <logger>logger</logger>
                <message>message</message>
            </fieldNames>
        </encoder>

        <!-- Política de rotação por tamanho (50MB) e por data -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Padrão do nome dos arquivos arquivados/compactados -->
            <fileNamePattern>${LOG_PATH}/archived/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            
            <!-- Limite máximo por arquivo individual -->
            <maxFileSize>50MB</maxFileSize>
            
            <!-- Retém o histórico por no máximo 30 dias -->
            <maxHistory>90</maxHistory>
            
            <!-- Limite total de armazenamento no disco para o histórico de logs -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Configuração dos Loggers Root e da Aplicação -->
    <root level="INFO">
        <appender-ref ref="CONSOLE_JSON" />
        <appender-ref ref="FILE_JSON" />
    </root>

    <!-- Nível customizado de log para o pacote raiz da sua aplicação -->
    <logger name="br.com.src.srcsoftware" level="DEBUG" />

</configuration>